# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/debug.log

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

/dist/
/.wrangler/
/outputs/
/work/
/.tunnel/
*.tsbuildinfo
/supabase/.branches/
/supabase/.temp/

# local agent/tooling settings; .claude/settings.local.json commonly holds
# machine-local credentials that must never be committed
.claude/

# local diagnostics; public anon key cache and hosted env pulls stay out of git
anon-key.txt
.env.vercel
chunk-scan.txt
vercel-deploys.txt
page.html
signup.json
